# Copy this file to `.env` (which is git-ignored) before running locally or with Docker Compose.
#
# AUTH_SECRET is the HMAC-SHA256 signing key, Base64-encoded (32 bytes / 256 bits). The committed
# config/auth.json intentionally leaves auth_secret empty so the real key never lands in the repo;
# both services read it from this environment variable instead.
#
# The value below is a throwaway development key — generate your own with:
#   openssl rand -base64 32
AUTH_SECRET=9Sg24fTI7Obt8+IoDlNQqiT9dkOzgzDrO2YasMKdMBQ=
